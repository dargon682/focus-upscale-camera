<?xml version="1.0" encoding="utf-8"?>
<!-- 主操作按钮：琥珀填充 + 微高光 + 按压波纹 -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/ripple_on_accent">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/radius_l" />
            <gradient
                android:angle="90"
                android:startColor="@color/accent_hi"
                android:centerColor="@color/accent"
                android:endColor="@color/accent_pressed"
                android:type="linear" />
        </shape>
    </item>
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/radius_l" />
            <solid android:color="#FFFFFF" />
        </shape>
    </item>
</ripple>