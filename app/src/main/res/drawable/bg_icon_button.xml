<?xml version="1.0" encoding="utf-8"?>
<!-- HUD 数值按钮：深色圆角胶囊 + 细机件描边 + 按压波纹 -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/ripple_on_surface">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/radius_pill" />
            <gradient
                android:angle="270"
                android:startColor="@color/toolbar_translucent"
                android:endColor="@color/surface_overlay_dark"
                android:type="linear" />
            <stroke
                android:width="1dp"
                android:color="@color/divider" />
        </shape>
    </item>
    <item android:id="@android:id/mask">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/radius_pill" />
            <solid android:color="#FFFFFF" />
        </shape>
    </item>
</ripple>