<?xml version="1.0" encoding="utf-8"?>
<!-- 现代机械快门：滚花金属外圈 + 凸起顶帽（受光面亮、底部暗）+ 外缘投影 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 外缘投影（快门浮于机体之上） -->
    <item
        android:top="3dp"
        android:left="3dp"
        android:right="3dp"
        android:bottom="-3dp">
        <shape android:shape="oval">
            <gradient
                android:angle="90"
                android:startColor="@color/accent_shadow"
                android:endColor="#00000000"
                android:centerColor="#55000000"
                android:type="linear" />
        </shape>
    </item>
    <!-- 外圈滚花（分段虚线 ≡ 机加工痕迹） -->
    <item>
        <shape android:shape="oval">
            <stroke
                android:width="7dp"
                android:color="@color/shutter_ring_hi"
                android:dashWidth="2.5dp"
                android:dashGap="4.5dp" />
        </shape>
    </item>
    <!-- 外环实心基座（受光上亮下暗） -->
    <item>
        <shape android:shape="oval">
            <gradient
                android:angle="90"
                android:startColor="#4A4E57"
                android:centerColor="#3A3E47"
                android:endColor="#26282F"
                android:type="linear" />
        </shape>
    </item>
    <!-- 中央黑色快门洞 -->
    <item android:top="7dp" android:bottom="7dp" android:left="7dp" android:right="7dp">
        <shape android:shape="oval">
            <solid android:color="@color/shutter_inner" />
        </shape>
    </item>
    <!-- 凸起顶帽：上亮下暗的垂直渐变 -->
    <item android:top="15dp" android:bottom="15dp" android:left="15dp" android:right="15dp">
        <shape android:shape="oval">
            <gradient
                android:angle="90"
                android:startColor="#A6ABB4"
                android:centerColor="#5A5F69"
                android:endColor="#24262C"
                android:type="linear" />
        </shape>
    </item>
    <!-- 顶帽高光圆点（surface 反射） -->
    <item android:top="20dp" android:bottom="20dp" android:left="20dp" android:right="20dp">
        <shape android:shape="oval">
            <gradient
                android:angle="90"
                android:startColor="#DDE0E4"
                android:centerColor="#6A6F79"
                android:endColor="#2E3138"
                android:type="linear" />
        </shape>
    </item>
    <!-- 琥珀取景环（对焦/拍摄感） -->
    <item android:top="15dp" android:bottom="15dp" android:left="15dp" android:right="15dp">
        <shape android:shape="oval">
            <stroke
                android:width="1dp"
                android:color="@color/accent_soft" />
        </shape>
    </item>
</layer-list>