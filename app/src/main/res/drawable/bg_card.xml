<?xml version="1.0" encoding="utf-8"?>
<!-- 面板卡：深色机体面板 + 顶部机件高光描边 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/radius_m" />
            <stroke
                android:width="1dp"
                android:color="@color/divider" />
            <gradient
                android:angle="270"
                android:startColor="#1E222A"
                android:centerColor="@color/bg_card"
                android:endColor="#11141A"
                android:type="linear" />
        </shape>
    </item>
</layer-list>