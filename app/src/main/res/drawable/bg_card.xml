<?xml version="1.0" encoding="utf-8"?>
<!-- 面板卡：深色机体面板 + 顶部机件高光描边 + 底部投影 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 底部投影（下坠映衬） -->
    <item
        android:left="0dp"
        android:top="0dp"
        android:right="0dp"
        android:bottom="-8dp">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/radius_m" />
            <solid android:color="@color/surface_overlay_dark" />
        </shape>
    </item>
    <!-- 机体面板主体 -->
    <item
        android:top="-6dp">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/radius_m" />
            <gradient
                android:angle="90"
                android:startColor="@color/surface_overlay_light"
                android:centerColor="@color/bg_card"
                android:endColor="#0E1116"
                android:type="linear" />
            <stroke
                android:width="1dp"
                android:color="@color/divider" />
        </shape>
    </item>
</layer-list>